# Database (Supabase Postgres — use the pooled "Transaction" connection string for the app
# and the direct connection for migrations)
DATABASE_URL="postgresql://postgres:password@db.xxxxx.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres"

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxx"
CLERK_SECRET_KEY="sk_test_xxxxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
CLERK_WEBHOOK_SECRET="whsec_xxxxx"

# Upstash Redis (cache + rate limiting) — cliente REST, sem conexão TCP
# persistente, ideal para funções serverless.
UPSTASH_REDIS_REST_URL="https://xxxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxxx"

# Redis via protocolo nativo (Fase 8 — Queue Engine/BullMQ) — o BullMQ exige
# um cliente ioredis com conexão TCP real, que a API REST acima não oferece.
# O Upstash Redis também expõe um endpoint compatível com o protocolo Redis
# (rediss://) para exatamente esse caso — normalmente a mesma instância,
# uma connection string diferente. Ausente = Queue Engine desliga sozinho
# (degradação graciosa, ver ADR-032); nada quebra, os efeitos colaterais
# assíncronos (analytics/webhooks/e-mail) simplesmente não são enfileirados.
REDIS_URL="rediss://default:xxxxx@xxxxx.upstash.io:6379"

# Segredo compartilhado que protege /api/queues/process (a rota que o Vercel
# Cron aciona para processar filas em ambiente serverless — ver ADR-033).
# Sem isso configurado, a rota se recusa a rodar.
CRON_SECRET="change-me-to-a-long-random-string"

# Sentry (Fase 8 — Observability Engine) — opcional. `Sentry.init` só roda
# quando esta variável existir (gate explícito em sentry.server.config.ts/
# sentry.edge.config.ts/instrumentation-client.ts) — sem DSN, o código
# instrumentado continua ali, pronto, mas nenhuma chamada de rede acontece.
# Nenhum projeto Sentry real está configurado neste produto. Ver ADR-034.
NEXT_PUBLIC_SENTRY_DSN=""

# Billing (Fase 15) — Stripe. Sem STRIPE_SECRET_KEY, toda rota de cobrança
# retorna 503 explícito (nunca finge cobrar). STRIPE_PRICE_* são os Price
# ids de assinatura recorrente criados no Dashboard do Stripe para os 3
# planos definidos em src/lib/plans.ts — nunca hardcoded, específicos da
# conta Stripe de quem roda o produto. STRIPE_WEBHOOK_SECRET vem de
# Developers > Webhooks > (seu endpoint) > Signing secret, depois de
# cadastrar https://SEU-DOMINIO/api/stripe/webhook lá.
STRIPE_SECRET_KEY="sk_test_xxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxx"
STRIPE_PRICE_STARTER="price_xxxxx"
STRIPE_PRICE_PRO="price_xxxxx"
STRIPE_PRICE_BUSINESS="price_xxxxx"

# Loja de cartões NFC físicos (Fase 15) — reaproveita STRIPE_SECRET_KEY
# acima em modo pagamento único (não assinatura, price_data inline por
# pedido). Sem env var própria: o catálogo (produto/quantidade/preço) é
# definido direto em src/lib/store-products.ts.

# E-mail transacional de pedidos (Auditoria do Fluxo de Vendas, 12/09/2026)
# — Resend. Sem RESEND_API_KEY, cada e-mail (confirmação/envio/entrega) só
# é logado, nunca enviado de verdade (degradação graciosa, ver lib/email.ts)
# — nada quebra, mas o cliente não recebe nada até isto ser configurado.
# RESEND_FROM_EMAIL precisa ser um domínio verificado na conta Resend.
RESEND_API_KEY="re_xxxxx"
RESEND_FROM_EMAIL="pedidos@seudominio.com.br"

# Painel Admin (Fase 16) — allowlist de e-mails (separados por vírgula) com
# acesso de super-admin a /admin/**. Ausente = ninguém entra (fail-closed).
SUPER_ADMIN_EMAILS="voce@seudominio.com.br"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Endereço do cartão (ADR-076) — é o que fica GRAVADO no chip NFC e IMPRESSO no
# QR. Cartão entregue não volta para ser regravado, então este domínio é para
# sempre: defina o definitivo (https, domínio próprio) ANTES do primeiro lote e
# nunca remova o domínio antigo da Vercel depois. Ausente = usa NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_CARD_BASE_URL=""
# Com =1, o ambiente recusa liberar URL de chip e gerar QR/PDF de impressão
# enquanto o endereço do cartão não for definitivo. Ligue em produção.
CARD_URL_REQUIRE_FINAL=""
IP_HASH_SALT="change-me-to-a-long-random-string"

# Dev Tools Gate (ADR-057) — libera `/dev/**`, `/api/dev/**` e o Chaos Engine
# num deploy real (o Next.js define NODE_ENV=production em QUALQUER build
# implantado, então sem isso essas ferramentas ficam inacessíveis até em
# Staging). Defina "true" SÓ no projeto Vercel de Staging — NUNCA em
# Produção, que deve deixar esta variável ausente. Sem efeito em dev local
# (next dev já libera essas rotas independentemente desta variável).
# ALLOW_DEV_TOOLS="true"

# Dev Runtime (Fase 12 — Self-Healing Development) — OPCIONAL, nunca ligar em
# produção (bloqueado por código mesmo se a variável vazar: ver
# src/lib/dev-runtime/config.ts). Com DEV_RUNTIME=1, todo o produto roda
# autenticado como o usuário semeado abaixo, sem nenhuma credencial real do
# Clerk — nunca mais precisa editar middleware.ts/layout.tsx para testar
# localmente. Deixe comentado (desligado) por padrão.
# DEV_RUNTIME="1"
# DEV_RUNTIME_EMAIL="owner@demo.com"
