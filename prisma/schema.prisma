// NFC Review Pro — Prisma schema
// Multi-tenant model: every row that belongs to a company carries a
// `companyId`, including tables nested two levels deep (Visit, RatingEvent,
// PrivateFeedback). This denormalization is deliberate: it lets every
// analytics/list query filter directly on companyId instead of joining
// through NFCCard, which keeps tenant isolation a one-line `where` clause
// everywhere instead of something that can be forgotten in a nested join.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Connection URLs live in prisma7.config.ts (CLI/migrations) and in the
// PrismaPg adapter passed to `new PrismaClient()` (app runtime) — Prisma 7
// no longer reads `url` from the schema file.
datasource db {
  provider = "postgresql"
}

// RBAC v2 (Phase 4). Replaces OWNER/ADMIN/STAFF — existing STAFF rows map to
// OPERATOR on migration (closest semantic match: front-line, not managing).
// See PHASE_4_REPORT.md for the full permission matrix and ARCHITECTURE_DECISIONS.md
// ADR-014 for why this is a role list, not a full custom-permission-per-user
// system (that's a bigger investment than this phase's actual need).
enum Role {
  OWNER
  ADMIN
  MARKETING
  MANAGER
  OPERATOR
  READ_ONLY
}

enum PlanType {
  STARTER
  PRO
  BUSINESS
}

// Motor de Ativação (Fase 18) — distingue uma empresa que só comprou o
// cartão físico (nunca teve, e pode nunca vir a ter, um User com login) de
// uma empresa assinante de verdade. GUEST é criada silenciosamente pelo
// webhook de pagamento (ver services/store-order.service.ts) só para o
// cartão físico ter um `companyId` para existir — nunca aparece como
// "cliente ativo do SaaS", nunca tem `User`, nunca acessa /dashboard. Vira
// CUSTOMER pelo fluxo de upgrade (claimGuestCompany) sem recriar cartões.
// Ver ADR-065.
enum AccountType {
  GUEST
  CUSTOMER
}

enum TeamMemberStatus {
  PENDING
  ACTIVE
}

// CampaignType.REVIEW_FLOW is a reserved value: no Campaign row is ever
// created with this type. The legacy star-rating flow stays a pure code
// fallback (see resolution-engine/resolve.ts) for a company with zero
// campaigns. Several of these types (GOOGLE_REVIEWS/INSTAGRAM/TIKTOK/
// DIGITAL_MENU/LANDING_PAGE/URL_REDIRECT) share the exact same "redirect to
// a URL" rendering (see lib/campaign-destination.ts) — the enum stays this
// granular anyway because it carries real meaning for the merchant (icon,
// label, analytics grouping in a later phase), not because rendering needs it.
enum CampaignType {
  REVIEW_FLOW
  URL_REDIRECT
  GOOGLE_REVIEWS
  INSTAGRAM
  TIKTOK
  DIGITAL_MENU
  LANDING_PAGE
  WHATSAPP
  COUPON
  AI_MENU
}

// Retorno (Pulse, ADR-078) — ciclo de vida de um brinde. `EXPIRED` é
// materializado por limpeza periódica, mas a leitura nunca depende dele: a
// validade é sempre conferida contra `expiresAt` na hora (vencimento na
// leitura), então um brinde vencido nunca resgata mesmo sem a limpeza ter
// rodado. `VOIDED` é anulação manual (erro de resgate, fraude).
enum VoucherStatus {
  ISSUED
  REDEEMED
  EXPIRED
  VOIDED
}

// Quem criou a campanha. `USER` é tudo o que o dono monta no painel.
// `SYSTEM_DIRECT` é o redirecionamento inicial do cartão avulso (criado ao
// provisionar o pedido) e `SYSTEM_RETURN` é a campanha COUPON do Retorno:
// campanhas do sistema não aparecem para edição no construtor do Pro e são as
// que a conversão ao assinar o Starter transforma no lugar, sem recriar cartão.
enum CampaignOrigin {
  USER
  SYSTEM_DIRECT
  SYSTEM_RETURN
}

// Ordered by specificity, most to least: CARD > ZONE > BRANCH > COMPANY >
// ORGANIZATION — see resolution-engine/resolve.ts's
// compareBySpecificityThenPriorityThenRecency. ORGANIZATION (Phase 4) is the
// one scope whose CampaignAssignment.organizationId reaches across company
// boundaries within an Organization — every other scope stays inside the
// assignment's own companyId. See ADR-013.
enum TargetScope {
  ORGANIZATION
  COMPANY
  BRANCH
  ZONE
  CARD
}

// The stored source of truth for engine eligibility (only ACTIVE is ever
// resolved, alongside the startsAt/endsAt window check). SCHEDULED and
// COMPLETED are deliberately NOT stored states — they're pure UI labels
// computed from ACTIVE + dates (see domain/campaign/status.ts) so flipping
// them never needs a cron/scheduler (that's later-phase infra).
enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

// Captured by the Campaign Builder (Phase 2) and enforced by the Rule Engine
// (Phase 3, resolution-engine/rules.ts) via a synthesized DAY_OF_WEEK +
// TIME_WINDOW check built from recurrenceConfig — see that file for why this
// is translated into the same Rule evaluation path rather than special-cased.
enum RecurrenceType {
  NONE
  DAILY
  WEEKLY
}

// Deliberately does NOT include table/zone/unit/campaign-state dimensions —
// those are already expressed by CampaignAssignment.scope (Phase 1/2) and a
// resolver's own priority/window ordering respectively. Rule only adds
// *temporal* and *contextual* conditions that layer on top of any
// assignment regardless of its scope. See PHASE_3_REPORT.md for the full
// reasoning behind not duplicating scope-matching here.
enum RuleType {
  DAY_OF_WEEK
  TIME_WINDOW
  DATE_RANGE
  DEVICE_TYPE
}

enum RedirectOutcome {
  REVIEW_FLOW_FALLBACK
  CAMPAIGN
}

// Deliberately covers high-value mutations only (campaigns, team, access
// scopes, company/organization settings) — not every CRUD in the app. A
// full audit trail of everything is Phase 8's event-sourcing job; this is a
// lightweight "who/when" log for the actions an Owner actually asks about.
enum AuditAction {
  CAMPAIGN_CREATED
  CAMPAIGN_UPDATED
  CAMPAIGN_ARCHIVED
  CAMPAIGN_DELETED
  CAMPAIGN_ASSIGNED
  CAMPAIGN_UNASSIGNED
  TEAM_MEMBER_INVITED
  TEAM_MEMBER_ROLE_CHANGED
  TEAM_MEMBER_REMOVED
  ACCESS_SCOPE_GRANTED
  ACCESS_SCOPE_REVOKED
  COMPANY_SETTINGS_UPDATED
  ORGANIZATION_CREATED
  // --- Smart Campaign Playbooks (Fase 11) ---
  RECOMMENDATION_APPLIED
  RECOMMENDATION_IGNORED
  PLAYBOOK_EXECUTION_UNDONE
  AUTOPILOT_LEVEL_CHANGED
  // --- Retorno (Pulse, ADR-078/079) ---
  REWARD_OFFER_UPDATED
  REWARD_PIN_CHANGED
  VOUCHER_VOIDED
  RETURN_PILOT_CHANGED
}

// --- Smart Campaign Playbooks (Fase 11) ---
// O gatilho de um Playbook é sempre um entre um conjunto FIXO e pequeno de
// avaliadores puros (`domain/playbooks/triggers.ts`) — o que varia por
// Playbook é só o `triggerConfig` (limiares, janela de horário, tags de
// mesa) e o `actionConfig`, ambos dados, nunca código. Um "Playbook" novo
// nunca exige um deploy — só uma linha nova em `Playbook` reaproveitando um
// `triggerType`/`actionType` já existente. Ver ADR-048.
enum PlaybookTriggerType {
  ZONE_TIME_PERFORMANCE // uma zona converte melhor numa janela de horário do que no resto do dia
  RATING_DROP // taxa de conversão para avaliação caiu de forma significativa vs. a linha de base
  SOCIAL_MOMENTUM // toques num canal social (Instagram) subindo, com campanha existente para impulsionar
  VIP_TABLE_IDLE // uma mesa marcada "vip" está silenciosa há tempo demais
  ZONE_SILENT // uma zona inteira está sem nenhum toque há tempo demais
  LUNCH_WINDOW_UNDERUSED // a janela de almoço tem participação nos toques abaixo do esperado
  WEEKEND_FORECAST_UP // a projeção linear da campanha líder aponta alta indo para o fim de semana
}

enum PlaybookActionType {
  ASSIGN_CAMPAIGN_TO_SCOPE // atribui uma campanha já existente a um escopo (nunca cria)
  CREATE_AND_ASSIGN_CAMPAIGN // cria uma campanha nova (sempre WHATSAPP/GOOGLE_REVIEWS — únicos tipos com dado garantido em Company) e atribui
  BOOST_CAMPAIGN_PRIORITY // aumenta a prioridade de uma campanha já ativa
  PAUSE_CAMPAIGN // pausa uma campanha já ativa
}

enum PlaybookCategory {
  REVENUE
  REPUTATION
  ENGAGEMENT
  CAPACITY
}

enum RecommendationStatus {
  PENDING
  APPLIED
  IGNORED
  EXPIRED
}

enum PlaybookExecutionStatus {
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  UNDONE
  CANCELLED
}

enum AutoPilotLevel {
  MANUAL
  RECOMMENDED
  SEMI_AUTOMATIC
  AUTOMATIC
}

// Catálogo GLOBAL e declarativo (não por empresa — ver ADR-048): a "Biblioteca
// de Playbooks Inteligentes" pedida é um conjunto compartilhado de receitas,
// semeado uma vez (`prisma/seed.ts`), nunca hardcoded em componente React ou
// serviço. Editar um limiar aqui nunca exige tocar em código.
model Playbook {
  id                     String              @id @default(cuid())
  key                    String              @unique // slug estável ("happy-hour-boost") — nunca muda, é o identificador real
  name                   String
  description            String
  category               PlaybookCategory
  triggerType            PlaybookTriggerType
  // Limiares do gatilho (amostra mínima, delta mínimo, janela de horário) —
  // consumidos por domain/playbooks/triggers.ts, nunca por número mágico
  // embutido em código.
  triggerConfig          Json
  actionType             PlaybookActionType
  // Parâmetros da ação: tipo de campanha preferido para criação
  // (WHATSAPP/GOOGLE_REVIEWS), modelo de mensagem, regra de tempo a anexar
  // (TIME_WINDOW/DAY_OF_WEEK), delta de prioridade, etc. — tudo dado.
  actionConfig           Json
  estimatedDurationHours Int
  // Frase pronta (PT-BR) explicando como desfazer esta ação específica —
  // mostrada no Explainability Panel, nunca inventada na hora pela UI.
  reversalDescription    String
  // Só playbooks marcados aqui podem ser executados sem confirmação humana
  // no nível AutoPilot "Automático" — ver ADR-049 (Autonomy Review).
  safeForAutomation      Boolean             @default(false)
  active                 Boolean             @default(true)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  recommendations PlaybookRecommendation[]
}

// Uma sugestão concreta, gerada pelo Recommendation Engine para UMA empresa e
// UM escopo (zona/mesa/empresa), nunca um insight solto — é isto que vira um
// cartão em /dashboard/playbooks e na coluna "Próximas melhores ações".
model PlaybookRecommendation {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  playbookId String
  playbook   Playbook @relation(fields: [playbookId], references: [id], onDelete: Cascade)

  status            RecommendationStatus @default(PENDING)
  // 0..1, calculado por domain/playbooks/confidence-engine.ts a partir de
  // amostra/efeito/recência — nunca um número decorativo. Explainability
  // First exige mostrar isto sempre, nunca escondido atrás de "recomendado".
  confidence        Float
  confidenceFactors Json // [{ label, value, weight }] — o detalhamento exibido no Explainability Panel
  // { conversõesEsperadas, avaliaçõesEsperadas, receitaInfluenciada, label } —
  // sempre rotulado como estimativa, nunca uma promessa (ver domain/playbooks/impact.ts).
  estimatedImpact   Json
  // Dados usados + comparação histórica + eventos responsáveis + regra
  // disparada — o conteúdo bruto do botão "Ver motivo".
  evidence          Json
  headline          String // "A Varanda converte 42% melhor depois das 18h..."
  scopeType         TargetScope // reaproveita o enum já usado por CampaignAssignment — nunca um scope paralelo
  scopeId           String? // zoneId/branchId/cardId conforme scopeType; null quando COMPANY
  // Preenchido só quando o gatilho encontrou uma campanha JÁ EXISTENTE para
  // agir sobre (Instagram Momentum, Weekend Accelerator) — nunca inventado.
  // Sem @relation de propósito: sobrevive a uma campanha arquivada/excluída
  // depois, mesma razão de EventLog não ter FK (ADR-032).
  targetCampaignId  String?

  expiresAt         DateTime?
  respondedAt       DateTime?
  respondedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  execution PlaybookExecution?

  @@index([companyId, status])
  @@index([playbookId])
  @@index([companyId, playbookId, scopeType, scopeId])
}

// O registro de uma aplicação real — sempre criado no momento de "Aplicar",
// nunca antes. `actionsTaken` guarda o suficiente do estado ANTERIOR para o
// Undo ser completo (nunca parcial) — ver Achados do Architect Review em
// RELATORIO_FASE_11.md.
model PlaybookExecution {
  id               String                 @id @default(cuid())
  companyId        String
  company          Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recommendationId String                 @unique
  recommendation   PlaybookRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  status            PlaybookExecutionStatus @default(RUNNING)
  triggeredBy       String // "USER" | "AUTOPILOT" — nunca ambíguo, sempre exibido (Autonomy Review)
  triggeredByUserId String?
  // O que foi feito de verdade: [{ type, campaignId, assignmentIds,
  // ruleId, campaignWasCreated, previousStatus, previousPriority }] —
  // suficiente para reverter sem adivinhar.
  actionsTaken      Json?
  scheduledFor      DateTime? // "executar depois"
  recurrence        Json? // "repetir" — { type: "DAILY"|"WEEKLY", until? }
  startedAt         DateTime?
  completedAt       DateTime?
  undoneAt          DateTime?
  failureReason     String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([companyId, status])
  @@index([scheduledFor])
}

// Um nível por empresa (nunca por usuário — a decisão de autonomia é do
// negócio, não de quem está logado no momento). Ausência de linha = MANUAL,
// o nível mais conservador (ver ADR-049).
model AutoPilotSetting {
  id              String         @id @default(cuid())
  companyId       String         @unique
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  level           AutoPilotLevel @default(MANUAL)
  updatedAt       DateTime       @updatedAt
  updatedByUserId String?
}

// The franchise brand — optional, wraps multiple Company accounts. Deliberately
// does NOT replace Company as the tenant/isolation boundary: every existing
// query, service, and API route still scopes by companyId exactly as before.
// A Company with organizationId=null (every company before Phase 4, and every
// single-location business after it) is completely unaffected. See ADR-013.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies           Company[]
  campaignAssignments CampaignAssignment[]
}

model Company {
  id                          String        @id @default(cuid())
  organizationId              String?
  organization                Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  name                        String
  slug                        String        @unique
  logoUrl                     String?
  // Preparação para White Label (Fase 10, ainda não implementada) — mesmo
  // padrão de `logoUrl`: nulo até a fase construir a UI de upload e o
  // `<link rel="icon">` dinâmico que a lê. Ver ADR-039.
  faviconUrl                  String?
  // C15 — passaram de obrigatórios pra opcionais: o onboarding deixou de
  // pedir isso ANTES do pagamento (o pedido original é só o nome da
  // empresa). Ficam preenchidos só depois, na tela de ativação pós-compra
  // (`/onboarding/ativar`) — nulos entre a criação da empresa e esse passo,
  // nunca uma string vazia fingindo ser um valor real.
  whatsapp                    String?
  googleReviewUrl             String?
  primaryColor                String        @default("#0F172A")
  // White Label (Fase 10) — cor secundária opcional; sem ela, a UI de marca
  // deriva um tom neutro de `primaryColor` (ver domain/white-label/color.ts),
  // nunca inventa uma cor sem relação com a marca escolhida.
  secondaryColor              String?
  // `domain` já existia desde uma fase anterior (ver ADR-039) — sem uso até
  // agora. Nesta fase ganha um leitor de verdade: `domainVerifiedAt` é nulo
  // até uma checagem real de DNS (TXT) confirmar posse do domínio; o
  // DomainResolver nunca resolve branding por um domínio não verificado
  // (ver ADR-042).
  domain                      String?       @unique
  domainVerifiedAt            DateTime?
  // Token aleatório por tentativa de verificação — o empresário publica
  // `_nfcos-challenge.<domínio> TXT "<domainVerificationToken>"` no DNS;
  // `verifyDomainOwnership` confirma via uma consulta DNS-over-HTTPS real
  // antes de `domainVerifiedAt` ser preenchido. Nunca reaproveita um
  // segredo de outra finalidade (ex.: IP_HASH_SALT) — token de posse de
  // domínio é uma preocupação própria. Ver ADR-042.
  domainVerificationToken     String?
  // Tela de login com marca própria (Fase 10) — ambos opcionais, nulos até
  // configurados; sem eles a tela de login mostra o padrão do produto.
  loginHeadline               String?
  loginBackgroundUrl          String?
  plan                        PlanType      @default(STARTER)
  // Motor de Ativação (Fase 18) — ver comentário do enum AccountType.
  accountType                 AccountType   @default(CUSTOMER)
  // Billing (Stripe) — nulos até o primeiro checkout. `stripeCustomerId` é
  // criado uma vez e reaproveitado em toda assinatura futura da empresa;
  // `stripeSubscriptionStatus` espelha literalmente o `status` do Subscription
  // object da Stripe ("active", "past_due", "canceled", etc.) — nunca um
  // enum próprio, para nunca ficar dessincronizado do vocabulário real da
  // Stripe. `plan` acima continua sendo a fonte da verdade para limites/
  // features do produto; o webhook do Stripe é o único escritor de `plan`
  // depois do checkout inicial. Ver ADR-062.
  stripeCustomerId            String?       @unique
  stripeSubscriptionId        String?       @unique
  stripeSubscriptionStatus    String?
  // Quando `stripeSubscriptionStatus` mudou pela última vez (escrito só pelo
  // webhook do Stripe). Sem isto não dá para contar a tolerância de 7 dias de
  // uma cobrança atrasada nem os 90 dias de leitura depois de cancelar. Ver
  // domain/billing (tier efetivo) e ADR-078.
  subscriptionStatusChangedAt DateTime?
  // Piloto do Retorno (ADR-078, default revisado no C14/ADR-089) — nasceu
  // "falso, só o Admin liga" enquanto o Retorno ainda era validado. Desde o
  // C8 o marketing promete "Faça cada cliente voltar" pra todo Starter; uma
  // empresa nova ficar sem o recurso que ela comprou até o Admin lembrar de
  // ligar na mão virou o problema, não a segurança. Default vira `true` —
  // continua exigindo assinatura ativa + brinde configurado + PIN definido
  // antes do brinde aparecer de verdade (nada muda nessa trava), e o
  // toggle manual em /admin/empresas/[id] continua existindo como
  // interruptor de exceção (desligar uma empresa específica), não mais
  // como porta de entrada obrigatória. Empresas já existentes não mudam —
  // é só o valor pra CRIAÇÃO nova.
  returnPilotEnabled          Boolean       @default(true)
  // E-mails transacionais/reengajamento (C9/F6, ADR-084) — mesmo padrão
  // idempotente de `StoreOrder.confirmationEmailSentAt`: cada campo só é
  // preenchido depois de um envio confirmado (`sent: true`), nunca antes, e
  // sua presença é o que impede reenvio automático duplicado numa nova
  // tentativa/retry do webhook ou do cron. `billingPastDueEmailSentAt` é
  // zerado de volta a nulo quando a assinatura volta a "active"/"trialing" —
  // um novo atraso futuro precisa poder avisar de novo.
  returnActivatedEmailSentAt     DateTime?
  subscriptionWelcomeEmailSentAt DateTime?
  billingPastDueEmailSentAt      DateTime?
  subscriptionCanceledEmailSentAt DateTime?
  // Reengajamento D+7/D+30 (J7 do plano): só dispara para quem ainda não
  // ativou o Retorno. `reengagementD30EmailSentAt` preenchido travas os dois
  // lembretes para sempre (ver domain/return-offer/reengagement.ts) — nunca
  // manda o lembrete de 7 dias depois do de 30.
  reengagementD7EmailSentAt  DateTime?
  reengagementD30EmailSentAt DateTime?
  // IANA identifier. Used by the Rule Engine to evaluate DAY_OF_WEEK/
  // TIME_WINDOW/DATE_RANGE rules in the business's local time, not the
  // server's — a "Friday 18:00" Happy Hour rule must mean 6pm in the
  // restaurant, not 6pm UTC. Defaults to Brazil since every string in this
  // product is already pt-BR; a real timezone picker is a Settings UI
  // nicety, not a Phase 3 blocker.
  timezone                    String        @default("America/Sao_Paulo")
  // ROI Mode (Fase 7) — configuração opcional, definida uma vez pelo
  // empresário em Configurações, que transforma toques/conversões em
  // dinheiro estimado. Os três campos só existem juntos (nulos até o
  // empresário configurar pela primeira vez); o Analytics Engine só calcula
  // receita influenciada quando os três estão preenchidos — nunca estima
  // com valores parciais ou inventados. Ver ADR-029.
  roiAvgTicket                Float?
  roiReturnRate               Float?
  roiNewCustomerValue         Float?
  // C15 — "primeiro comprei, agora vamos ativar seu negócio": preenchido só
  // quando o dono completa `/onboarding/ativar` (WhatsApp, Google, cor) DEPOIS
  // do pagamento confirmado. Nulo = empresa criada mas ainda não ativada;
  // `ActivationBanner` no dashboard lê isto pra nunca deixar uma empresa
  // "pela metade" invisível ao dono. Nunca reescrito numa edição comum de
  // Configurações depois (rota própria, `POST /api/company/activate`).
  activatedAt                 DateTime?
  createdAt                   DateTime      @default(now())
  updatedAt                   DateTime      @updatedAt

  users                   User[]
  cards                   NFCCard[]
  visits                  Visit[]
  ratingEvents            RatingEvent[]
  privateFeedbacks        PrivateFeedback[]
  campaigns               Campaign[]
  campaignAssignments     CampaignAssignment[]
  redirectLogs            RedirectLog[]
  branches                Branch[]
  zones                   Zone[]
  rules                   Rule[]
  campaignVariants        CampaignVariant[]
  ruleExecutionLogs       RuleExecutionLog[]
  userAccessScopes        UserAccessScope[]
  auditLogs               AuditLog[]
  apiKeys                 ApiKey[]
  webhookEndpoints        WebhookEndpoint[]
  apiRequestLogs          ApiRequestLog[]
  playbookRecommendations PlaybookRecommendation[]
  playbookExecutions      PlaybookExecution[]
  autoPilotSetting        AutoPilotSetting?
  supportRequests         SupportRequest[]
  rewardOffer             RewardOffer?
  vouchers                Voucher[]

  @@index([organizationId])
}

model User {
  id        String           @id @default(cuid())
  clerkId   String?          @unique
  companyId String
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email     String
  name      String?
  role      Role             @default(OPERATOR)
  status    TeamMemberStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  ownedCampaigns  Campaign[]
  accessScopes    UserAccessScope[]
  auditLogs       AuditLog[]
  createdApiKeys  ApiKey[]
  supportRequests SupportRequest[]

  @@unique([companyId, email])
  @@index([companyId])
}

enum SupportRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

// Fase 20 — Central de Suporte: até aqui não existia NENHUM jeito do dono
// de uma empresa cliente falar com o operador da plataforma (NFC OS) a
// partir do próprio Dashboard — só o caminho contrário (Central do Cliente
// do Admin, Fase 19.7, olhando PARA a empresa). Modelo deliberadamente
// simples (sem thread, sem SLA, sem prioridade) — mesma decisão já tomada
// na Fase 19.7 para `PrivateFeedback`: uma "Central de Tickets" completa é
// um projeto à parte, não um pré-requisito pra uma primeira venda real.
model SupportRequest {
  id         String               @id @default(cuid())
  companyId  String
  company    Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  subject    String
  message    String
  status     SupportRequestStatus @default(OPEN)
  resolvedAt DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([companyId, createdAt])
  @@index([status, createdAt])
}

// Página pública /contato (C9/F6) — para quem escreve ANTES de ter conta
// (visitante, cliente final de uma empresa, imprensa/parceria): sem
// `companyId`, de propósito. Diferente de `SupportRequest` (sempre um
// cliente já logado, dentro de uma empresa) — misturar os dois exigiria
// `companyId` opcional em `SupportRequest` e reescrever toda query de lá.
// A notificação por e-mail (`sendEmail`, best-effort) é só um aviso — esta
// linha é o registro de verdade, sobrevive mesmo sem domínio de e-mail
// verificado ainda.
model ContactMessage {
  id          String    @id @default(cuid())
  name        String
  email       String
  message     String
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@index([createdAt])
}

// RECTANGLE/CIRCLE only — matches the two shapes every reference floor-plan
// editor actually needs (a rectangular table or a round one); anything more
// exotic (L-shaped booths, bar counters) can render as a RECTANGLE with a
// custom width/height ratio without a new shape. See Phase 5 report.
enum TableShape {
  RECTANGLE
  CIRCLE
}

model NFCCard {
  id             String     @id @default(cuid())
  companyId      String
  company        Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uniqueCode     String     @unique
  // Motor de Ativação (Fase 18) — link pessoal de autoedição para clientes
  // GUEST (portal /meu-cartao, ver services/campaign.service.ts). Nunca
  // gerado para cartões de empresas CUSTOMER (essas já têm o dashboard
  // completo com RBAC de verdade; um segundo token seria superfície de
  // risco sem uso). Deliberadamente diferente de `uniqueCode`: o código
  // gravado no chip físico nunca deve dobrar como link de edição.
  editToken      String?    @unique
  name           String
  tags           String[]   @default([])
  // LEGADO (ADR-076) — deixou de ser gravado: o QR sai sob demanda de
  // /api/qr/[code]. Continua na tabela só porque remover coluna é migração de
  // contração; sai na F10, depois do deploy que para de escrevê-la.
  qrCodeUrl      String?
  active         Boolean    @default(true)
  // Both nullable and independent (a card can belong to a Branch without a
  // Zone, e.g. a simple multi-location business that skips zoning). A
  // ZONE-scope or BRANCH-scope CampaignAssignment matches by direct equality
  // against these fields — never inferred transitively through zone.branchId
  // — so there's no cross-referencing to keep consistent. See Phase 2 report
  // for why the richer Organization/Branch hierarchy stays deferred while
  // this minimal, single-company-scoped version ships now.
  branchId       String?
  branch         Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  zoneId         String?
  zone           Zone?      @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  // Table Map (Phase 5) layout — entirely optional and additive. `layoutX`/
  // `layoutY` are null until a merchant actually drags this card onto the
  // canvas for the first time (an "unplaced" table); every other layout
  // field has a sane default so a freshly-placed table renders immediately
  // without a separate "configure it" step. None of this is read by the
  // Campaign Resolution Engine — it's purely a dashboard visualization/
  // editing concern, kept on NFCCard rather than a separate table since a
  // "table" IS the NFCCard here, not a different entity that happens to
  // reference one. See ADR-019.
  layoutX        Float?
  layoutY        Float?
  layoutWidth    Float      @default(80)
  layoutHeight   Float      @default(80)
  layoutRotation Float      @default(0)
  tableShape     TableShape @default(RECTANGLE)
  seats          Int        @default(4)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  visits              Visit[]
  campaignAssignments CampaignAssignment[]
  redirectLogs        RedirectLog[]
  ruleExecutionLogs   RuleExecutionLog[]
  vouchers            Voucher[]

  @@index([companyId])
  @@index([branchId])
  @@index([zoneId])
}

// A physical location ("unidade") within a company. Optional — a company
// with zero Branch rows is a single-location business, unaffected. See
// NFCCard's comment for how this deliberately stays flatter than the full
// Organization -> Franquia -> Unidade hierarchy from the long-term roadmap.
model Branch {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cards               NFCCard[]
  zones               Zone[]
  campaignAssignments CampaignAssignment[]
  userAccessScopes    UserAccessScope[]

  @@index([companyId])
}

// A grouping of cards ("zona", e.g. VIP/Varanda/Interno) — optionally under
// a Branch, or company-wide for a single-location business that still wants
// to group tables without formally modeling multiple locations.
model Zone {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cards               NFCCard[]
  campaignAssignments CampaignAssignment[]
  userAccessScopes    UserAccessScope[]

  @@index([companyId])
  @@index([branchId])
}

// Opt-in RESTRICTION, not a grant system: a user with zero rows has
// unrestricted access within whatever their `role` already permits
// (the default for every user before Phase 4, and every user Phase 4
// doesn't explicitly restrict). One or more rows narrow that user to only
// the listed branch(es)/zone(es) — a branch-level row implies every zone
// under that branch. Exactly one of {branchId, zoneId} is set per row,
// enforced at the application layer (src/domain/rbac/scope.ts), same
// pattern as CampaignAssignment's scope/target pairing. See ADR-015.
model UserAccessScope {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  zoneId    String?
  zone      Zone?    @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, branchId, zoneId])
  @@index([companyId])
  @@index([userId])
  @@index([branchId])
  @@index([zoneId])
}

// "Quem fez, quando fez, de onde fez" — deliberately covers high-value
// mutations only (see AuditAction). ipHash uses the same salted-hash
// convention as public visitor tracking (src/lib/ip.ts) for consistency,
// even though these are internal actions, not anonymous public ones — one
// privacy convention, not a special case for staff. `targetId` is a plain
// string, not a foreign key: the target table varies by action (a campaign
// id, a member id, ...), so this is intentionally loose, resolved by the
// UI/report reader rather than the database.
model AuditLog {
  id        String      @id @default(cuid())
  companyId String
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    AuditAction
  targetId  String?
  metadata  Json?
  ipHash    String?
  createdAt DateTime    @default(now())

  @@index([companyId, createdAt])
  @@index([userId])
}

// --- Event Sourcing (Fase 8) ---
// O registro durável de todo evento de domínio publicado pelo Event Bus
// (`src/lib/event-bus/`) — a fonte da verdade para o Replay de Eventos e
// para reconstruir o que aconteceu mesmo que as filas (BullMQ/Redis) não
// estejam disponíveis no momento da publicação. Deliberadamente SEM
// relação de chave estrangeira com `Company`/`Organization`: um log de
// eventos precisa sobreviver e continuar consultável mesmo que a entidade
// que ele descreve mude ou seja removida depois — é o oposto do
// acoplamento forte que uma FK expressaria. `companyId`/`organizationId`
// são simples colunas indexadas, não relações. Ver ADR-032.
model EventLog {
  id             String   @id @default(cuid())
  // Nome do evento em português, exatamente como definido em
  // domain/events/types.ts (ex.: "RedirecionamentoResolvido") — uma string
  // livre, não um enum do Postgres, para que novos tipos de evento nunca
  // precisem de uma migração de schema, só de uma atualização de código.
  type           String
  // Versão do formato do payload — permite evoluir o "contrato" de um
  // evento (novos campos, campos renomeados) sem quebrar consumidores/
  // replays antigos, que podem checar `version` e lidar com formatos
  // anteriores explicitamente.
  version        Int      @default(1)
  companyId      String?
  organizationId String?
  correlationId  String
  payload        Json
  createdAt      DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([type, createdAt])
  @@index([correlationId])
}

model Visit {
  id               String    @id @default(cuid())
  cardId           String
  card             NFCCard   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  device           String?
  browser          String?
  os               String?
  ipHash           String
  country          String?
  city             String?
  // Cookie `pv` do Retorno (ADR-078): identificador aleatório do aparelho,
  // definido pelo servidor. Serve só de atalho para reconhecer o celular; quem
  // dá direito ao brinde é o código. Nunca dado pessoal declarado.
  visitorId        String?
  // Quando o cliente tocou no botão principal (o destino do dono) na tela do
  // cartão. Registro de 1 clique por visita; substitui, para a tela sem
  // estrelas, o que `RatingEvent.redirectedGoogle` contava (ADR-080).
  primaryClickedAt DateTime?
  createdAt        DateTime  @default(now())

  ratingEvent      RatingEvent?
  privateFeedbacks PrivateFeedback[]
  vouchers         Voucher[]

  @@index([companyId, createdAt])
  @@index([cardId, createdAt])
  @@index([companyId, visitorId])
}

model RatingEvent {
  id               String   @id @default(cuid())
  visitId          String   @unique
  visit            Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cardId           String
  stars            Int
  redirectedGoogle Boolean  @default(false)
  createdAt        DateTime @default(now())

  privateFeedback PrivateFeedback?

  @@index([companyId, createdAt])
  @@index([cardId, createdAt])
}

model PrivateFeedback {
  id             String       @id @default(cuid())
  // Retorno (ADR-078): "Falar com a gente" passa a existir sem a pergunta de
  // nota, então o vínculo com a nota vira opcional (Postgres aceita vários
  // nulos numa coluna única) e a mensagem se liga à visita.
  ratingEventId  String?      @unique
  ratingEvent    RatingEvent? @relation(fields: [ratingEventId], references: [id], onDelete: Cascade)
  visitId        String?
  visit          Visit?       @relation(fields: [visitId], references: [id], onDelete: SetNull)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String?
  phone          String?
  message        String
  resolved       Boolean      @default(false)
  whatsappSentAt DateTime?
  createdAt      DateTime     @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, resolved])
  @@index([visitId])
}

// --- Retorno (Pulse, C4 / ADR-078) ---
// O brinde de próxima visita: emitido a quem toca o cartão, resgatado com o
// código mais o PIN da loja. Sem aplicativo, cadastro ou telefone. As regras
// (liberação no dia seguinte, validade, carência, tentativas de PIN, motivos de
// recusa) vivem em domain/return-offer, puras e testadas; estas tabelas só
// guardam o estado.

// A configuração do brinde de uma empresa. Uma por empresa. Sem `pinHash` o
// brinde não pode ser resgatado, então o serviço recusa ativá-lo antes de haver PIN.
model RewardOffer {
  id           String    @id @default(cuid())
  companyId    String    @unique
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // O que o cliente ganha, como aparece na tela ("Hidratação grátis").
  title        String
  description  String?
  // Quantos dias o brinde vale a partir do dia em que é liberado (padrão 14;
  // barbearia e salão têm ciclo de 2 a 4 semanas, restaurante pode pedir 7).
  windowDays   Int       @default(14)
  // Dias entre a emissão de um brinde e a emissão do próximo ao mesmo
  // aparelho: limita o custo por cliente.
  cooldownDays Int       @default(30)
  // PIN de 4 dígitos da loja, só como hash. Nunca o valor.
  pinHash      String?
  pinUpdatedAt DateTime?
  // Botão principal da tela do Retorno. Nulo = o link de avaliação do Google
  // da empresa. Ao assinar o Starter, recebe o destino que o dono escolheu na
  // compra do cartão avulso, então nada do que ele configurou se perde.
  primaryUrl   String?
  // Teto de brindes emitidos por dia (fuso da empresa). Nulo = sem teto; sem
  // valor padrão até o piloto mostrar qual faz sentido.
  dailyCap     Int?
  // Pausa do dono. Falso = nenhum brinde novo é emitido; os já emitidos
  // continuam valendo até vencer.
  active       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  vouchers Voucher[]
}

model Voucher {
  id           String        @id @default(cuid())
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  offerId      String
  offer        RewardOffer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  // Cartão em que o toque aconteceu; nulo se o cartão for excluído depois (o
  // brinde continua valendo, é da empresa).
  cardId       String?
  card         NFCCard?      @relation(fields: [cardId], references: [id], onDelete: SetNull)
  visitId      String?
  visit        Visit?        @relation(fields: [visitId], references: [id], onDelete: SetNull)
  // Cookie `pv` do aparelho que recebeu o brinde (atalho de reconhecimento).
  visitorId    String?
  // 6 caracteres sem vogais nem 0, 1, I, L, O (ex.: K7X4QM, mostrado como
  // K7X-4QM), único por empresa. O código É o brinde: vale em qualquer aparelho.
  code         String
  // Foto do texto do brinde na emissão: o dono pode mudar o brinde depois sem
  // reescrever o que o cliente já recebeu.
  title        String
  status       VoucherStatus @default(ISSUED)
  issuedAt     DateTime      @default(now())
  // Libera no dia seguinte (fuso da empresa) para o cliente não tocar e
  // resgatar na mesma visita.
  availableAt  DateTime
  expiresAt    DateTime
  redeemedAt   DateTime?
  voidedAt     DateTime?
  voidedReason String?

  @@unique([companyId, code])
  @@index([companyId, status, expiresAt])
  @@index([companyId, visitorId, issuedAt])
  @@index([companyId, issuedAt])
  @@index([companyId, redeemedAt])
}

// --- Campaign Resolution Engine (Phase 1) ---
// Pipeline: NFCCard (asset) -> CampaignAssignment -> Campaign -> destination.
// The asset never carries a destination itself; see src/lib/resolution-engine.

model Campaign {
  id               String         @id @default(cuid())
  companyId        String
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  type             CampaignType
  status           CampaignStatus @default(DRAFT)
  // Higher wins. Ties are broken by assignment scope specificity (CARD beats
  // ZONE beats BRANCH beats COMPANY) then recency — see resolution-engine/resolve.ts.
  priority         Int            @default(0)
  startsAt         DateTime?
  endsAt           DateTime?
  recurrenceType   RecurrenceType @default(NONE)
  // Shape depends on recurrenceType, e.g. {"daysOfWeek":[5],"startTime":"18:00","endTime":"22:00"}
  // for WEEKLY. Captured for the Rule Engine phase — not evaluated yet.
  recurrenceConfig Json?
  tags             String[]       @default([])
  ownerId          String?
  owner            User?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  // Shape is discriminated by `type` — validated at read time with the Zod
  // schemas in src/lib/validations/campaign.ts, never trusted as typed.
  config           Json
  // ROI Mode (Fase 7) — opcional. Sem isso, "ROI da campanha" e "custo por
  // avaliação" não têm como ser calculados honestamente (não existe
  // integração de gasto de anúncio neste produto) — o Analytics Engine
  // mostra "configure o custo desta campanha" em vez de inventar um número.
  estimatedCost    Float?
  // Ver o comentário do enum CampaignOrigin (ADR-078).
  origin           CampaignOrigin @default(USER)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  assignments       CampaignAssignment[]
  redirectLogs      RedirectLog[]
  rules             Rule[]
  variants          CampaignVariant[]
  ruleExecutionLogs RuleExecutionLog[]

  @@index([companyId, status])
}

// Additional eligibility conditions for a Campaign, layered on top of its
// assignments' scope matching and its own startsAt/endsAt window — e.g. "only
// Fridays 18-22h" alongside a COMPANY-scope assignment, without needing a
// dedicated Zone just to express a time restriction. All rules on a campaign
// are combined with AND (every rule must pass) — this is a deliberate Phase 3
// simplification; OR/rule-groups are not implemented.
model Rule {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  type       RuleType
  // Shape is discriminated by `type` — see src/lib/validations/rule.ts.
  config     Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId])
  @@index([campaignId])
}

// A/B testing variant for a Campaign's destination. weight is a relative
// share of traffic (e.g. 50/50 or 70/30 — need not sum to 100, the resolver
// normalizes). A campaign with zero variants keeps using its own `config`
// directly, unchanged from Phase 1/2 behavior — variants are additive, never
// required.
model CampaignVariant {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name       String
  weight     Int      @default(50)
  // Same shape as Campaign.config for the same campaign type — validated
  // with the same Zod schemas (src/lib/validations/campaign.ts).
  config     Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  redirectLogs RedirectLog[]

  @@index([campaignId])
}

// Exactly one of {organizationId, branchId, zoneId, cardId} is set, matching
// `scope` (COMPANY sets none) — enforced at the application layer in
// domain/campaign/assignment.ts, not by the database. Note: Postgres's
// unique constraints never treat two NULLs as equal, so the @@unique below
// does NOT by itself stop a duplicate row for ANY scope here — COMPANY has
// all 4 target columns null, and CARD/ZONE/BRANCH/ORGANIZATION each still
// have 3 of the 4 null, which is enough to defeat the whole composite
// constraint for that row (a single null column anywhere in a unique
// constraint's key exempts that row from the comparison, regardless of
// what its other columns contain). campaign.service.ts's assignCampaign
// closes this for every scope with an explicit existence check (matched by
// real equality — Prisma's `null` becomes `IS NULL`, not a broken NULL-vs-
// NULL constraint comparison) inside the same Serializable transaction,
// rather than a DB constraint, since Prisma's schema DSL has no
// partial-unique-index syntax.
//
// `organizationId` (Phase 4) is the one field on this model that reaches
// OUTSIDE `companyId`'s tenant boundary on purpose: an ORGANIZATION-scope
// assignment resolves for every card in every company within that
// organization, not just the company that owns this row. `companyId` still
// records which company's dashboard created the assignment (ownership/audit);
// `organizationId` is what the resolution engine actually reads for reach.
// This is the ONLY place in the schema where a query intentionally crosses
// company boundaries — see ADR-013 and resolution-engine/data.ts's
// loadOrganizationCampaigns().
model CampaignAssignment {
  id             String        @id @default(cuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaignId     String
  campaign       Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  scope          TargetScope
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  zoneId         String?
  zone           Zone?         @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  cardId         String?
  card           NFCCard?      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@unique([campaignId, scope, organizationId, branchId, zoneId, cardId])
  @@index([companyId, scope])
  @@index([organizationId])
  @@index([branchId])
  @@index([zoneId])
  @@index([cardId])
}

// Lightweight, best-effort audit trail of resolution decisions (written via
// next/server's after(), off the redirect response path). Not a substitute
// for real event sourcing (planned for a later phase) — writes can be lost
// on a hard crash. NOT_FOUND codes are deliberately never logged here: there
// is no tenant to attribute them to, which would be the one exception to
// this schema's "every row carries companyId" convention; that abuse
// surface is already covered by the existing publicCard rate limiter.
model RedirectLog {
  id                String           @id @default(cuid())
  companyId         String
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cardId            String
  card              NFCCard          @relation(fields: [cardId], references: [id], onDelete: Cascade)
  campaignId        String?
  campaign          Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  // Which A/B variant was shown, if the winning campaign had any (Phase 3).
  variantId         String?
  variant           CampaignVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  outcome           RedirectOutcome
  resolvedFromCache Boolean          @default(false)
  createdAt         DateTime         @default(now())

  @@index([companyId, createdAt])
  @@index([cardId, createdAt])
  @@index([campaignId, createdAt])
}

// Debugging/audit trail for the Rule Engine — one row per CANDIDATE campaign
// that actually had rules attached (not one row per individual rule, to keep
// volume bounded), capturing whether it passed overall and the per-rule
// breakdown. Written via next/server's after(), same best-effort semantics
// as RedirectLog. The common case (a campaign with zero rules) writes
// nothing here at all — this table's volume scales with how many campaigns
// use rules, not with total traffic.
model RuleExecutionLog {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  cardId      String
  card        NFCCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  passed      Boolean
  // [{ ruleId, type, passed }] — the individual rule breakdown.
  ruleResults Json
  createdAt   DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([campaignId, createdAt])
}

// --- API Pública v1 (Fase 9) ---
// Uma ApiKey representa acesso de servidor-a-servidor a uma Company inteira
// — nunca a um usuário específico, nunca herda RBAC de User. Carrega seus
// próprios `scopes` (ex.: "cards:write"), checados independentemente do
// papel de quem a criou. Nunca armazenamos o segredo em texto puro: o valor
// completo (`nfc_live_<random>`) só existe no momento da criação, exibido
// uma única vez; a partir daí só `keyPrefix` (os 12 primeiros caracteres,
// para o usuário reconhecer qual chave é qual numa lista) fica visível, e
// toda autenticação futura compara o hash SHA-256 de quem chega contra
// `keyHash` — o mesmo padrão do Stripe/GitHub. Ver ADR-036.
model ApiKey {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  keyPrefix       String
  keyHash         String    @unique
  scopes          String[]
  createdByUserId String?
  createdByUser   User?     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([companyId])
}

// Um endpoint de webhook registrado pelo desenvolvedor — substitui o único
// par Company.webhookUrl/webhookSecret da Fase 8 por N endpoints por
// empresa, cada um com sua própria lista de eventos assinados e seu próprio
// segredo HMAC. `events` guarda os nomes PÚBLICOS do evento (ex.:
// "campaign.created"), nunca o nome interno em português do Event Bus —
// esse desacoplamento é deliberado: o contrato público de nomes de evento
// pode evoluir independentemente dos nomes internos do domínio. Ver ADR-036.
model WebhookEndpoint {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  url         String
  description String?
  secret      String
  events      String[]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([companyId])
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  EXHAUSTED
}

// Histórico real de tentativas de entrega — o que alimenta "Últimas
// chamadas"/Replay no Dashboard de Desenvolvedor. Ao contrário de EventLog
// (Fase 8), esta tabela TEM foreign key para seu WebhookEndpoint: uma
// entrega só faz sentido enquanto o endpoint que a originou existir, e
// remover um endpoint deve mesmo levar seu histórico junto.
model WebhookDelivery {
  id            String                @id @default(cuid())
  endpointId    String
  endpoint      WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  eventId       String
  eventType     String
  payload       Json
  status        WebhookDeliveryStatus @default(PENDING)
  attempts      Int                   @default(0)
  responseCode  Int?
  errorMessage  String?
  lastAttemptAt DateTime?
  createdAt     DateTime              @default(now())

  // Uma linha por (endpoint, evento) — nunca duas: se um job de fila com
  // vários endpoints falhar em UM deles e o BullMQ tentar de novo, o worker
  // usa isso para pular endpoints que já receberam este evento com sucesso,
  // em vez de entregar duas vezes. Ver lib/workers/processors.ts.
  @@unique([endpointId, eventId])
  @@index([endpointId, createdAt])
  @@index([eventId])
}

// Uma linha por requisição feita via /api/v1/** — alimenta o painel "Logs"
// do Dashboard de Desenvolvedor (latência, status, endpoint) com dados
// reais, nunca fabricados. Gravado via after(), best-effort, mesmo padrão
// de RedirectLog (Fase 1)/EventLog (Fase 8) — nunca no caminho crítico da
// resposta. Sem foreign key para ApiKey de propósito: uma chave revogada ou
// excluída não deveria apagar o histórico de chamadas que ela já fez.
model ApiRequestLog {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  apiKeyId   String?
  method     String
  path       String
  statusCode Int
  latencyMs  Int
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([apiKeyId, createdAt])
}

// PENDING_PAYMENT → PAID é automático (webhook do Stripe). PAID → SHIPPED →
// DELIVERED avança manualmente por quem opera o envio (Painel Admin, Fase
// 16) — não existe integração de logística nesta fase, então esses dois
// passos são sempre uma ação humana explícita, nunca inferida.
enum StoreOrderStatus {
  PENDING_PAYMENT
  PAID
  SHIPPED
  DELIVERED
  CANCELED
  // Auditoria do Fluxo de Vendas (12/09/2026) — antes, "Cancelar" só mudava
  // este enum e nunca tocava o Stripe; o dinheiro do cliente continuava
  // cobrado até alguém entrar manualmente no Dashboard do Stripe e estornar
  // à parte. Ver refundStoreOrder em store-order.service.ts.
  REFUNDED
}

// Motor de Ativação (Fase 18) — distingue os dois checkouts que geram um
// StoreOrder: a loja avulsa (/loja, sempre convidado-compatível) e o
// checkout combinado dentro de /onboarding/plan (sempre já autenticado,
// companyId nunca nulo). Nunca inferido do `companyId` sozinho (um
// CARD_ONLY pode ganhar companyId depois, via associação silenciosa ou
// provisionamento) — por isso é um campo próprio, gravado uma vez no
// checkout e nunca mudado depois.
enum StoreOrderType {
  CARD_ONLY
  CARD_PLUS_SAAS
}

// Loja pública de cartões NFC físicos (Fase 15) — deliberadamente
// desacoplada de `Company`/autenticação: um comprador da loja não precisa
// ter (ou nunca chegar a ter) uma conta no SaaS. `destinationUrl` é o link
// que o cliente escolhe no checkout para onde seus cartões devem
// redirecionar assim que chegarem fisicamente — capturado aqui para quem
// for fabricar/configurar os chips, já que o fulfillment ainda é manual
// (nenhuma integração com fornecedor/logística nesta fase, ver ADR-062).
// `status` avança PENDING_PAYMENT → PAID via webhook do Stripe
// (`checkout.session.completed`); FULFILLED/CANCELED são atualizados
// manualmente por quem opera o envio, não pelo código.
model StoreOrder {
  id                      String           @id @default(cuid())
  stripeCheckoutSessionId String           @unique
  stripePaymentIntentId   String?
  customerEmail           String
  customerName            String
  // Motor de Ativação (Fase 18) — CPF/CNPJ e telefone, coletados no
  // checkout (loja avulsa e combinado) para nota fiscal futura e contato
  // direto se a produção travar. Opcionais só para não quebrar pedidos já
  // existentes antes desta migração — todo checkout novo passa a exigi-los.
  customerDocument        String?
  customerPhone           String?
  // Endereço de cobrança — deliberadamente separado de `shippingAddress`
  // (podem divergir; `shippingAddress` já vem pronto do Stripe Checkout).
  billingAddress          Json?
  orderType               StoreOrderType   @default(CARD_ONLY)
  // Preenchido só quando o comprador já tinha uma sessão ativa no SaaS no
  // momento da compra (associação silenciosa, nunca uma pergunta "você tem
  // conta?" no checkout — a maioria dos e-commerces reais não força essa
  // escolha). Nulo para todo comprador convidado, que é o caminho padrão.
  companyId               String?
  productId               String
  quantity                Int
  destinationUrl          String
  amountTotalCents        Int
  status                  StoreOrderStatus @default(PENDING_PAYMENT)
  shippingAddress         Json?
  // Motor de Ativação (Fase 18) — checklist real de produção, granular o
  // bastante para o Admin nunca precisar adivinhar onde um pedido travou.
  // `status` acima continua sendo o resumo simplificado que o cliente vê;
  // estes timestamps são a esteira interna. `provisionedAt` abaixo já cobre
  // "cartões criados" — não duplicado aqui.
  stockConfirmedAt        DateTime?
  // Fase 19.3 — "Impressão" vira etapa própria no quadro de 8 colunas
  // (Pago/Separação/Impressão/Programação NFC/Qualidade/Embalagem/
  // Expedição/Entregue). "Separação" reaproveita `stockConfirmedAt` (mesma
  // ação: confirmar que o material físico está separado/disponível) — só
  // esta é campo novo de verdade.
  printedAt               DateTime?
  nfcWrittenAt            DateTime?
  qcPassedAt              DateTime?
  packagedAt              DateTime?
  shippedAt               DateTime?
  deliveredAt             DateTime?
  trackingCode            String?
  carrier                 String?
  // Provisionamento (Fase 17) — quando um admin transforma um pedido pago em
  // `NFCCard`s reais, prontos para o cliente ver no Mapa de Mesas. Nulo até
  // isso acontecer; `provisionedCardIds` guarda os ids criados para nunca
  // duplicar cartões se a ação for chamada de novo por engano (idempotente).
  provisionedAt           DateTime?
  provisionedCardIds      String[]         @default([])
  // Auditoria do Fluxo de Vendas (12/09/2026) — antes, uma contestação de
  // pagamento (`charge.dispute.created`) só ficava registrada em log; nada
  // no Admin avisava que existia dinheiro em risco. `disputeStatus` guarda o
  // vocabulário do próprio Stripe (needs_response/under_review/won/lost...)
  // — nunca reinventado aqui, é exatamente o que o webhook recebe.
  disputedAt              DateTime?
  disputeStatus           String?
  refundedAt              DateTime?
  refundAmountCents       Int?
  // E-mail transacional (12/09/2026) — um timestamp por etapa, não um
  // boolean: além de idempotência (nunca reenvia a mesma etapa duas vezes),
  // vira histórico visível no detalhe do pedido ("confirmação enviada às
  // 14:32"). `null` cobre tanto "ainda não chegou nesta etapa" quanto
  // "chegou, mas o envio falhou" — ver lib/email.ts, que nunca lança, só loga.
  confirmationEmailSentAt DateTime?
  shippedEmailSentAt      DateTime?
  deliveredEmailSentAt    DateTime?
  notes                   StoreOrderNote[]
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([companyId])
}

// Auditoria do Fluxo de Vendas (12/09/2026) — histórico de anotações
// internas por pedido ("cliente ligou reclamando de atraso em 10/09"), nunca
// visível ao comprador. Modelo próprio (não um campo `String?` sobrescrito
// no `StoreOrder`) para preservar todas as notas anteriores, não só a
// última — o mesmo motivo de `RuleExecutionLog` guardar histórico em vez de
// um campo mutável.
model StoreOrderNote {
  id        String     @id @default(cuid())
  orderId   String
  order     StoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime   @default(now())

  @@index([orderId, createdAt])
}

// Painel Admin (Fase 16) — configuração global do site público (não de uma
// empresa cliente), editável só pelo super-admin. Singleton de verdade: uma
// única linha, sempre com `id = "singleton"` (nunca `findMany`, sempre
// `upsert` no mesmo id) — nunca existe um segundo "site" para configurar.
// `storeProductOverrides` é um mapa `{ [productId]: { imageUrl?, unitPriceCents? } }`
// mesclado por cima do catálogo estático em `lib/store-products.ts` na hora
// de renderizar — o super-admin nunca edita preço/imagem sem esse catálogo
// base já existir (nome, quantidade, descrição continuam fixos no código).
model SiteSettings {
  id                    String   @id @default("singleton")
  heroVideoUrl          String?
  storeProductOverrides Json?
  // Motor de Ativação (Fase 18) — contador simples de chips NFC em branco
  // disponíveis para gravação. Decrementado a cada `NFCCard` provisionado
  // pela loja (ver services/store-order.service.ts); editável manualmente
  // pelo Admin em /admin/conteudo quando repor estoque com o fornecedor.
  // `lowStockThreshold` só controla o aviso visual — nunca bloqueia um
  // provisionamento (ficar sem estoque é uma decisão operacional do dono,
  // não uma trava de sistema).
  blankChipStock        Int      @default(0)
  lowStockThreshold     Int      @default(20)
  // Interruptor geral do Retorno (ADR-078). Falso desliga a emissão e o
  // resgate para todas as empresas na hora, sem deploy nem migração: o cartão
  // volta ao comportamento anterior (destino direto ou tela de avaliação).
  returnOfferEnabled    Boolean  @default(true)
  updatedAt             DateTime @updatedAt
  updatedByEmail        String?
}
